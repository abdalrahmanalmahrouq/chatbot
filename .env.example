# Core API
CORE_PORT=8000
CORE_ORCHESTRATOR_URL=http://localhost:8001
CORE_REQUEST_TIMEOUT_SECONDS=30

# Logging
LOG_LEVEL=INFO

# Open WebUI. Set the secret and administrator password only in your local .env.
OPENWEBUI_IMAGE=ghcr.io/open-webui/open-webui:v0.11.3
OPENWEBUI_PORT=3000
WEBUI_SECRET_KEY=replace-with-openssl-rand-hex-32-output
WEBUI_ADMIN_EMAIL=admin@example.com
WEBUI_ADMIN_NAME=Admin
WEBUI_ADMIN_PASSWORD=replace-with-a-local-admin-password
OPENWEBUI_ENABLE_SIGNUP=false
OPENWEBUI_ENABLE_OLLAMA_API=true
OPENWEBUI_ENABLE_OPENAI_API=true
OPENWEBUI_OPENAI_API_BASE_URLS=http://core:8000/v1
OPENWEBUI_OPENAI_API_KEYS=
OPENWEBUI_OPENAI_API_CONFIGS={"0":{"enable":true,"auth_type":"none","headers":{"X-OpenWebUI-Chat-Id":"{{CHAT_ID}}"}}}

# Orchestrator API
ORCHESTRATOR_PORT=8001
ORCHESTRATOR_DATABASE_URL=postgresql+asyncpg://chatbot:change-me@localhost:5432/chatbot
ORCHESTRATOR_REDIS_URL=redis://localhost:6379/0
ORCHESTRATOR_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
ORCHESTRATOR_OPENROUTER_API_KEY=change-me-openrouter-key
ORCHESTRATOR_OLLAMA_BASE_URL=http://localhost:11434
ORCHESTRATOR_OLLAMA_ENABLED=false
ORCHESTRATOR_PROVIDER_TIMEOUT_SECONDS=60
# Optional: used only when a request does not specify a model.
# ORCHESTRATOR_FALLBACK_MODEL=openai/gpt-4.1-mini

# Guardrails. Leave blocked terms empty to disable that policy locally.
ORCHESTRATOR_INPUT_MAX_CHARACTERS=12000
ORCHESTRATOR_OUTPUT_MAX_CHARACTERS=24000
ORCHESTRATOR_BLOCKED_TERMS=credential dump,malware payload,self-harm instructions

# Local Docker PostgreSQL only. This is not a production secret.
POSTGRES_PASSWORD=change-me
